#!/usr/bin/env bash

set -euox pipefail

THIS_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

# Export a local kubeconfig path to avoid using the default one
mkdir -p "${THIS_DIR}/local"
export KUBECONFIG="${THIS_DIR}/local/kubeconfig.yaml"

CLUSTER_NAME="kiada-cluster"


run() {
	uv run -- uvicorn 'main:app' --host 0.0.0.0 --port 8080 --reload
}

docker-run() {
	# docker run -p 8080:8080 kiada:latest

	# remove the container if it exists
	# docker rm -f kiada 2>/dev/null || true

	# # run the container
	# docker run --rm --name kiada \
	# 	--publish 8080:8080 \
	# 	--volume "${THIS_DIR}/static:/app/static" \
	# 	--volume "${THIS_DIR}/templates:/app/templates" \
	# 	--volume "${THIS_DIR}/main.py:/app/main.py" \
	# 	--volume "${THIS_DIR}/pyproject.toml:/app/pyproject.toml" \
	# 	--volume "${THIS_DIR}/README.md:/app/README.md" \
	# 	--volume "${THIS_DIR}/uv.lock:/app/uv.lock" \
	# 	--volume "${THIS_DIR}/run:/app/run" \
	# 	kiada:latest

	docker compose up --build --remove-orphans
}

docker-build() {
	docker build -t kiada:latest .
}


# Create a 3 node kubernetes cluster using kind
create-cluster() {
	# Check if docker is running
	if ! docker info > /dev/null 2>&1; then
		echo "Docker is not running"
		exit 1
	fi

	# remove the cluster if it exists
	kind delete cluster --name ${CLUSTER_NAME} || true

	# Create a 3 node kubernetes cluster using kind
	cat <<-EOF | kind create cluster --config -
apiVersion: kind.x-k8s.io/v1alpha4
kind: Cluster
name: ${CLUSTER_NAME}
nodes:
    - role: control-plane
    - role: worker
    - role: worker
EOF

}

delete-cluster() {
	kind delete cluster --name ${CLUSTER_NAME}
}

# Create a deployment of kiada app in the cluster
create-deployment() {
	# build the latest docker image
	docker-build

	# use the local image directly from host
	kind load docker-image --name ${CLUSTER_NAME} kiada:latest

	# # create a deployment
	# kubectl create deployment kiada --image=kiada:latest || echo

	# Patch the deployment to use the local image
	# kubectl patch deployment my-app -p '{"spec":{"template":{"spec":{"containers":[{"name":"my-local-image","imagePullPolicy":"Never"}]}}}}'

	# Create deployment using a manifest file
	kubectl apply -f "${THIS_DIR}/manifests/deployment.yaml"
}



# remove all files generated by tests, builds, or operating this codebase
clean() {
	set -x

	rm -rf dist build coverage.xml test-reports/
	find . \
	  -type d \
	  \( \
		-name "*cache*" \
		-o -name "*.dist-info" \
		-o -name "*.egg-info" \
		-o -name "*htmlcov" \
        -o -name "cdk.out" \
	  \) \
	  -not -path "*env*/*" \
	  -exec rm -r {} + || true

	find . \
	  -type f \
	  -name "*.pyc" \
	  -not -path "*env/*" \
	  -exec rm {} +
}


# print all functions in this file
help() {
    echo "$0 <task> <args>"
    echo "Tasks:"
    compgen -A function | cat -n
}


TIMEFORMAT="Task completed in %3lR"
time ${@:-help}
